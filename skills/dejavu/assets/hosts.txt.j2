# Lines for the hosts file of {{ f.domain | ssh }}, made by dejavu {{ dejavu | ssh }}.
# Use them only when there is no DNS for *.{{ f.domain | ssh }}. One address per name: no failover.
{% set t = reach | selectattr("traefik") | first %}
{% for w in web %}
{{ (t.public_ip or t.address) | ssh }}  {{ w.host | ssh }}.{{ f.domain | ssh }}
{% endfor %}
