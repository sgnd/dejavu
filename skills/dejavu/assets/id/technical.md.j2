| Cache ({{ NAME.get(f.cache.app, f.cache.app) }}) | {% if f.cache.ha %}Satu primary dan dua salinan dengan Sentinel di {{ app[f.cache.app].nodes | join(", ") }}{% else %}Satu server: {{ runs_on(app[f.cache.app]) }}{% endif %} | {% if f.cache.ha %}Sentinel menjadikan salah satu salinan sebagai primary baru{% else %}Cache berhenti sampai server menyala kembali{% endif %} |
