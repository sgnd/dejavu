# Lampiran C. Konfigurasi {#appendix-config .unnumbered}

Berikut `config.yml` sebagaimana dibaca oleh ansibro, disusun ulang oleh dejavu. Komentar di file aslinya hilang, sebagian nilai adalah nilai bawaan, dan setiap rahasia diganti dengan lokasinya di file kredensial. Komentar di dalam blok di bawah ini sengaja dibiarkan dalam bahasa Inggris, seperti di file aslinya.

{% set REC = groups["recovery"][first_lang] ~ "/config.yml " %}
```yaml
domain: {{ f.domain }}
orchestrator: {{ f.orchestrator }}
tls: {{ f.tls }}
{% if f.acme_email %}
acme_email: {{ f.acme_email }}
{% endif %}
{% if f.acme_server %}
acme_server: https://{{ f.acme_server }}/...   # only the host is recorded
{% endif %}
{% if f.tls == "custom" %}
tls_cert: <file>   # the certificate file
tls_key: <file>    # the key file, not in this document
{% endif %}
timezone: {{ f.timezone }}
{% if f.offline %}
offline: true
{% endif %}
ssh:
  user: {{ f.ssh.user }}
  port: {{ f.ssh.port }}
  key: <your SSH private key>
{% if f.ssh.allow_from %}
  allow_from: [{{ f.ssh.allow_from | join(", ") }}]
{% endif %}
{% if f.admin_allow_from %}
admin_allow_from: [{{ f.admin_allow_from | join(", ") }}]
{% endif %}
{% if f.firewall_allow %}
firewall_allow:
{% for r in f.firewall_allow %}
  - {{ "{" }}{% for k, v in r.items() %}{{ k }}: {{ v }}{{ ", " if not loop.last else "" }}{% endfor %}{{ "}" }}
{% endfor %}
{% endif %}
{% if f.wireguard %}
wireguard: true
{% if f.wireguard_port != 51820 %}
wireguard_port: {{ f.wireguard_port }}
{% endif %}
{% endif %}
nodes:
{% for n in f.nodes %}
  - {name: {{ n.name }}, ip: {{ n.ip }}, host: {{ n.host }}, role: {{ n.role }}}
{% endfor %}
apps:
{% for x in f.apps %}
  {{ x.name }}: {% if x.cluster %}{{ "swarm" if swarm else "cluster" }}{% elif x.nodes | length == 1 %}{{ x.nodes[0] }}{% else %}[{{ x.nodes | join(", ") }}]{% endif %}

{% endfor %}
{% if mon == "victoria" %}
monitoring:
{% for c in f.monitoring.channels %}
{% if c.kind == "telegram" %}
  telegram:
    bot_token: <kdbx: {{ REC }}monitoring.telegram.bot_token>
    chat_id: <not recorded>
{% elif c.kind == "email" %}
  email:
    to: {{ c.to }}
    smarthost: {{ c.host }}:<port>
{% if "monitoring.email.password" in f.config_secrets %}
    password: <kdbx: {{ REC }}monitoring.email.password>
{% endif %}
{% else %}
  webhook: <kdbx: {{ REC }}monitoring.webhook>
{% endif %}
{% endfor %}
{% if f.monitoring.heartbeat %}
  heartbeat_url: <kdbx: {{ REC }}monitoring.heartbeat_url>
{% endif %}
  keep_days: {{ f.monitoring.keep_days }}
{% endif %}
{% if f.backup.enabled %}
backup:
{% if "backup.repository" in f.config_secrets %}
  repository: <kdbx: {{ REC }}backup.repository>
{% else %}
  repository: {{ f.backup.where if f.backup.kind == "local" else f.backup.kind ~ ":" ~ f.backup.where }}
{% endif %}
{% if "backup.s3_access_key" in f.config_secrets %}
  s3_access_key: <kdbx: {{ REC }}backup.s3_access_key>
  s3_secret_key: <kdbx: {{ REC }}backup.s3_secret_key>
{% endif %}
  time: "{{ f.backup.time }}"
  keep_daily: {{ f.backup.keep.daily }}
  keep_weekly: {{ f.backup.keep.weekly }}
  keep_monthly: {{ f.backup.keep.monthly }}
{% endif %}
```

