# How a laptop reaches {{ f.domain }}, made by dejavu {{ dejavu }}.
direction: right
laptop: {{ "Your laptop" | q }} {shape: person}
{% if f.traefik_nodes %}
web: {{ ("Web pages" ~ "\nhttps://*." ~ f.domain) | q }}
laptop -> web: {{ ("HTTPS 443" ~ ("\nlisted IPs only" if f.admin_allow_from else "")) | q }}
{% endif %}
{% set j = reach | selectattr("direct") | first | default(reach[0]) %}
ssh: {{ ("SSH " ~ j.name ~ "\n" ~ j.address ~ ":" ~ f.ssh.port) | q }}
laptop -> ssh: {{ ("SSH key" ~ ("\nlisted IPs only" if f.ssh.allow_from else "")) | q }}
{% if f.tunnels %}
private: {{ ("Private services" ~ "\n" ~ (f.tunnels | map(attribute="use") | unique | join(", "))) | q }} {shape: cylinder}
ssh -> private: {{ "SSH tunnel" | q }}
{% endif %}
