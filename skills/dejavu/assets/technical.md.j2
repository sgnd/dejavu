| {{ NAME.get(x.name, x.name) }} | {{ BACKUP.get(x.backup, x.backup) }} | {{ {"dump": "a full export of the databases", "paused": "the app is paused for a moment and its folder copied", "live": "copied while it runs; not guaranteed to be consistent", "partial": "only some folders are saved (see the app's notes)", "none": "nothing is saved"}.get(x.backup, "") }} |
