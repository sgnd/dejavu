# SSH settings for {{ (a.client.name or f.domain) | line }} ({{ f.domain | ssh }}), made by dejavu {{ dejavu | ssh }}.
# Add these lines to ~/.ssh/config (Windows: %USERPROFILE%\.ssh\config).
# The key file is your own key (or the one from the credentials file), never the vendor's.
{% for n in reach %}

Host {{ n.alias | ssh }}
  HostName {{ n.address | ssh }}
  User {{ f.ssh.user | ssh }}
  Port {{ f.ssh.port | ssh }}
  IdentityFile ~/.ssh/{{ slug | ssh }}_ed25519
  IdentitiesOnly yes
{% if n.jump %}
  ProxyJump {{ n.jump | ssh }}
{% endif %}
{% endfor %}
{% if f.tunnels %}

# A private pipe to the databases and other services: run "ssh -N {{ slug | ssh }}-tunnel" and keep it open.
# Then connect to 127.0.0.1 and the local port below.
{% set j = reach | selectattr("direct") | first | default(reach[0]) %}
Host {{ slug | ssh }}-tunnel
  HostName {{ j.address | ssh }}
  User {{ f.ssh.user | ssh }}
  Port {{ f.ssh.port | ssh }}
  IdentityFile ~/.ssh/{{ slug | ssh }}_ed25519
  IdentitiesOnly yes
  ExitOnForwardFailure yes
{% if j.jump %}
  ProxyJump {{ j.jump | ssh }}
{% endif %}
{% for t in f.tunnels %}
  # {{ t.use | line }} on {{ t.node | line }}
  LocalForward {{ t.local | ssh }} {{ t.ip | ssh }}:{{ t.port | ssh }}
{% endfor %}
{% endif %}
