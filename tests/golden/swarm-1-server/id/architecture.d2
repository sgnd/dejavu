# The architecture of maju.example.id, made by dejavu 1.0.0 from ansibro's facts.
direction: down
users: "Pengguna dan admin" {shape: person}
dns: "DNS *.maju.example.id" {shape: cloud}
users -> dns: HTTPS 443
cluster: "Docker Swarm" {
  "server1": "server1\nmanager · data\n10.10.0.10" {
    style.stroke-width: 3
    tooltip: "postgres, redis, rustfs, victoria"
  }
  services: "Aplikasi cluster\nportainer, traefik" {shape: hexagon}
}
