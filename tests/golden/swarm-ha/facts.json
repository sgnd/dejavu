  "components": [
    {
      "name": "registry",
      "where": "managers",
      "port": 5000,
      "version": "3.1.2",
      "license": "Apache-2.0",
      "about": "A private image registry on every manager. All servers pull images from it."
    },
    {
      "name": "database-proxy",
      "where": "cluster",
      "port": 5432,
      "version": "3.2.26",
      "license": "GPL-2.0",
      "about": "HAProxy in front of the HA database, always pointing at the primary."
    },
    {
      "name": "etcd",
      "where": "managers",
      "port": 12379,
      "version": "v3.6.16",
      "license": "Apache-2.0",
      "about": "The key-value store Patroni uses to elect the PostgreSQL primary."
    },
    {
      "name": "sentinel",
      "where": "cache servers",
      "port": 26379,
      "version": "",
      "license": "",
      "about": "Watches Redis or Valkey and moves the primary when it goes down."
    },
    {
      "name": "monitoring-agents",
      "where": "every server",
      "port": 9100,
      "version": "v1.12.1",
      "license": "Apache-2.0",
      "about": "node-exporter, cAdvisor, Vector and the database exporters on every server, plus the ansibro-metrics timer."
    },
    {
      "name": "backup",
      "where": "every server",
      "port": null,
      "version": "",
      "license": "BSD-2-Clause",
      "about": "The ansibro-backup timer with restic, every night on every server."
    },
    {
      "name": "wireguard",
      "where": "every server",
      "port": 51820,
      "version": "",
      "license": "GPL-2.0",
      "about": "The encrypted network between the servers only (not a VPN for laptops)."
    }
  ],
  "backup": {
    "enabled": true,
    "kind": "s3",
    "host": "s3.example.com",
    "where": "https://s3.example.com/my-bucket",
    "time": "02:00",
    "keep": {
      "daily": 7,
      "weekly": 4,
      "monthly": 6
    }
  },
  "monitoring": {
    "app": "victoria",
    "channels": [
      {
        "kind": "slack",
        "host": "hooks.slack.com"
      }
    ],
    "heartbeat": null,
    "keep_days": 30,
    "uptimekuma": true
  },
  "alerts": [
    {
      "group": "monitoring",
      "name": "TargetDown",
      "severity": "critical",
      "for": "3m",
      "summary": "<job> on <node> (<instance>) does not answer."
    },
    {
      "group": "monitoring",
      "name": "AlertsNotSent",
      "severity": "warning",
      "for": "",
      "summary": "Alertmanager could not send alerts to <integration>. Check monitoring: in config.yml."
    },
    {
      "group": "monitoring",
      "name": "AlertRulesFailing",
      "severity": "warning",
      "for": "",
      "summary": "Some alert rules cannot be checked, so their alerts would not fire."
    },
    {
      "group": "monitoring",
      "name": "MetricsScriptNotRunning",
      "severity": "warning",
      "for": "",
      "summary": "ansibro-metrics did not run on <node> for 5 minutes. App, backup and swarm checks there are blind."
    },
    {
      "group": "monitoring",
      "name": "LogsNotSent",
      "severity": "warning",
      "for": "",
      "summary": "The log agent on <node> cannot send logs to the monitoring server."
    },
    {
      "group": "servers",
      "name": "NodeDown",
      "severity": "critical",
      "for": "2m",
      "summary": "Server <node> is down or cannot be reached."
    },
    {
      "group": "servers",
      "name": "NodeRebooted",
      "severity": "warning",
      "for": "",
      "summary": "Server <node> restarted."
    },
    {
      "group": "servers",
      "name": "DiskAlmostFull",
      "severity": "warning",
      "for": "5m",
      "summary": "Disk <mountpoint> on <node> is … full."
    },
    {
      "group": "servers",
      "name": "DiskFull",
      "severity": "critical",
      "for": "2m",
      "summary": "Disk <mountpoint> on <node> is … full."
    },
    {
      "group": "servers",
      "name": "DiskFillsSoon",
      "severity": "warning",
      "for": "30m",
      "summary": "At this speed, disk <mountpoint> on <node> is full within a day."
    },
    {
      "group": "servers",
      "name": "InodesAlmostFull",
      "severity": "warning",
      "for": "5m",
      "summary": "Disk <mountpoint> on <node> has almost no free inodes (too many small files)."
    },
    {
      "group": "servers",
      "name": "MemoryAlmostFull",
      "severity": "warning",
      "for": "10m",
      "summary": "Memory on <node> is … used."
    },
    {
      "group": "servers",
      "name": "OutOfMemoryKill",
      "severity": "warning",
      "for": "",
      "summary": "Linux stopped a program on <node> because memory was full."
    },
    {
      "group": "servers",
      "name": "CpuBusy",
      "severity": "warning",
      "for": "15m",
      "summary": "CPU on <node> is … busy for 15 minutes."
    },
    {
      "group": "servers",
      "name": "ClockNotSynced",
      "severity": "warning",
      "for": "10m",
      "summary": "The clock on <node> is not in sync. Certificates, logins and the swarm need the right time."
    },
    {
      "group": "servers",
      "name": "SystemdServiceFailed",
      "severity": "warning",
      "for": "5m",
      "summary": "… system service(s) failed on <node>. Run: systemctl --failed"
    },
    {
      "group": "apps",
      "name": "AppDown",
      "severity": "critical",
      "for": "2m",
      "summary": "<app> on <node> does not answer on port <port>."
    },
    {
      "group": "apps",
      "name": "ContainerDown",
      "severity": "critical",
      "for": "2m",
      "summary": "Container <container> on <node> is not running."
    },
    {
      "group": "apps",
      "name": "ContainerRestarting",
      "severity": "warning",
      "for": "",
      "summary": "Container <container> on <node> restarted … times in 15 minutes."
    },
    {
      "group": "apps",
      "name": "ContainerOutOfMemory",
      "severity": "warning",
      "for": "",
      "summary": "Container <container> on <node> was stopped because it used too much memory."
    },
    {
      "group": "apps",
      "name": "SwarmServiceDown",
      "severity": "critical",
      "for": "5m",
      "summary": "Swarm service <service> runs … of its tasks. Run: docker service ps <service>"
    },
    {
      "group": "apps",
      "name": "SwarmNodeDown",
      "severity": "critical",
      "for": "2m",
      "summary": "Swarm says server <swarm_node> is not ready."
    },
    {
      "group": "apps",
      "name": "WebAppDown",
      "severity": "critical",
      "for": "3m",
      "summary": "Traefik cannot reach <service> (<url>)."
    },
    {
      "group": "apps",
      "name": "WebAppErrors",
      "severity": "warning",
      "for": "5m",
      "summary": "… of the requests to <service> fail with a 5xx error."
    },
    {
      "group": "apps",
      "name": "CertificateEndsSoon",
      "severity": "warning",
      "for": "",
      "summary": "The certificate for <sans> ends in … days."
    },
    {
      "group": "backup",
      "name": "BackupTooOld",
      "severity": "critical",
      "for": "30m",
      "summary": "The last good backup of <node> is older than 26 hours. Run: journalctl -u ansibro-backup"
    },
    {
      "group": "wireguard",
      "name": "WireGuardPeerDown",
      "severity": "critical",
      "for": "2m",
      "summary": "<node> cannot reach <peer> over WireGuard. Check UDP port 51820."
    },
    {
      "group": "databases",
      "name": "PostgresDown",
      "severity": "critical",
      "for": "1m",
      "summary": "PostgreSQL on <node> does not answer the exporter."
    },
    {
      "group": "databases",
      "name": "PostgresTooManyConnections",
      "severity": "warning",
      "for": "5m",
      "summary": "PostgreSQL on <node> uses … of its connections."
    },
    {
      "group": "databases",
      "name": "PostgresNoPrimary",
      "severity": "critical",
      "for": "2m",
      "summary": "No PostgreSQL server is the primary: apps cannot write. Check: sudo docker exec postgres patronictl list"
    },
    {
      "group": "databases",
      "name": "PostgresReplicaBehind",
      "severity": "warning",
      "for": "10m",
      "summary": "The PostgreSQL replica on <node> is … behind the primary."
    },
    {
      "group": "databases",
      "name": "CacheDown",
      "severity": "critical",
      "for": "1m",
      "summary": "<job> on <node> does not answer the exporter."
    },
    {
      "group": "databases",
      "name": "CacheNoPrimary",
      "severity": "critical",
      "for": "2m",
      "summary": "No cache server is the primary: apps cannot write. Check: sudo docker exec valkey-sentinel valkey-cli -p 26379 SENTINEL masters"
    },
    {
      "group": "databases",
      "name": "CacheMemoryFull",
      "severity": "warning",
      "for": "5m",
      "summary": "<job> on <node> uses … of its memory limit."
    },
    {
      "group": "databases",
      "name": "CacheRejectsConnections",
      "severity": "warning",
      "for": "",
      "summary": "<job> on <node> refused connections (too many clients)."
    }
  ],
