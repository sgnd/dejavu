#!/bin/sh
# dejavu: one package manager for AI agents, made of the ones that already exist.
#
# It installs CLI tools on Linux and macOS, on a desktop or a server, without
# asking questions, so an AI agent can do it for you. It does not install
# anything itself. It picks the right package manager and runs it:
#
#   - mise (https://mise.jdx.dev) for CLI tools and languages. It needs no admin
#     rights and works the same on every Linux and macOS. dejavu installs it.
#   - the system package manager (apt-get, dnf, yum, pacman, zypper, apk or
#     Homebrew) for the rest: system packages, servers and libraries.
#
# Start with:
#   curl -fsSL https://github.com/sgnd/dejavu/releases/latest/download/dejavu | sh -s -- setup
# Then:
#   dejavu help
#
# Written for POSIX sh, so it also runs where bash is missing (Alpine, slim containers).

set -eu
set -f # no wildcards: package names never need them

VERSION=0.3.0
# `setup` and `upgrade` download the newest release (dejavu and SKILL.md), never `main`: only tested versions.
# Forked this repo? Put your fork's address here, so they download your releases.
DOWNLOAD_URL="${DEJAVU_DOWNLOAD_URL:-https://github.com/sgnd/dejavu/releases/latest/download}"
MARKER="# added by dejavu"

say() { printf '==> %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 2; }

usage() {
  cat <<EOF
dejavu $VERSION: install CLI tools on Linux and macOS, without questions.

Usage:
  dejavu install NAME...   Install tools (also: add)
  dejavu remove NAME...    Remove tools (also: uninstall)
  dejavu upgrade [NAME...] Upgrade tools. No NAME: every mise tool, mise and dejavu
  dejavu search WORD       Find the right NAME
  dejavu list              Show your list: everything installed with dejavu, with versions
  dejavu restore [FILE|URL] Install everything in a list (yours, or one from another computer)
  dejavu doctor            Show this machine's setup, to find problems
  dejavu setup             Install mise and dejavu, set up PATH and the agent skill

NAME:
  ripgrep, node@lts, python@3.13   A tool from the mise registry (no admin rights needed)
  npm:prettier, pypi:black, github:owner/repo, cargo:..., go:...
                                   A package from that source, through mise
  system:nginx, system:build-essential
                                   A package from the system package manager
  skill:OWNER/REPO/NAME            An agent skill for your AI agents, from skills.sh
                                   (find one with: dejavu search skill:WORD)
  Any other name goes to the system package manager.

Result lines start with "ok:", "failed:" or "needs the user:".
Exit codes: 0 all ok, 1 something failed, 2 wrong usage,
3 the user must do something (like type their password): tell them what the line says.
Your list: ${XDG_CONFIG_HOME:-\$HOME/.config}/dejavu/packages.txt
Logs: ${XDG_STATE_HOME:-\$HOME/.local/state}/dejavu
EOF
}

# --- Paths -----------------------------------------------------------------

[ -n "${HOME:-}" ] || fail "HOME is not set."
# This script's full path, before dejavu moves to the home folder. Empty with `curl | sh`.
SELF=""
[ ! -f "$0" ] || SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
BIN_DIR="$HOME/.local/bin" # where mise.run puts mise, and setup puts dejavu
SHIMS="${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}/shims" # one small launcher per mise command
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dejavu"                  # logs and the lock
LIST="${XDG_CONFIG_HOME:-$HOME/.config}/dejavu/packages.txt"              # everything installed with dejavu

# Counters for the summary at the end.
OK=0
FAILED=0
NEEDS=0
NEED_PKGS="" # system packages that need the user, for one command at the end

# --- Start, lock and log ---------------------------------------------------

start() {
  case "$(uname -s)" in
    Darwin) OS=macos ;;
    Linux) OS=linux ;;
    *) fail "dejavu works on Linux and macOS only. This is $(uname -s)." ;;
  esac

  # sudo dejavu would put root-owned files in the user's home folder.
  if [ "$(id -u)" = 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    fail "Run dejavu without sudo. It asks for admin rights itself when it needs them."
  fi

  mkdir -p "$STATE_DIR" 2>/dev/null && [ -w "$STATE_DIR" ] ||
    fail "Cannot write to $STATE_DIR. If you run in a sandbox, ask the user to let dejavu run outside it."
  # Keep a week of logs.
  find "$STATE_DIR" -name '*.log' -mtime +7 -exec rm -f {} + 2>/dev/null || true
  LOG="$STATE_DIR/$(date +%Y%m%d-%H%M%S)-$$.log"
  TMP="$(mktemp -d)"
  : >"$TMP/fail"

  # One dejavu at a time: AI agents often run several commands at once,
  # and two package managers must not change the same files together.
  waited=0
  until mkdir "$STATE_DIR/lock" 2>/dev/null; do
    pid="$(cat "$STATE_DIR/lock/pid" 2>/dev/null || true)"
    # Stopped dejavu: its process is gone, or (in a new container) its number is now ours.
    if [ -n "$pid" ] && { [ "$pid" = $$ ] || ! kill -0 "$pid" 2>/dev/null; }; then
      rm -rf "$STATE_DIR/lock" # left behind by a dejavu that was stopped
      continue
    fi
    [ "$waited" != 0 ] || say "Another dejavu is running. Waiting for it to finish..."
    waited=$((waited + 1))
    [ "$waited" -le 1800 ] || { rm -rf "$TMP"; fail "Another dejavu has been running for 30 minutes. If none runs, delete $STATE_DIR/lock"; }
    sleep 1
  done
  echo $$ >"$STATE_DIR/lock/pid"
  trap 'rm -rf "$STATE_DIR/lock" "$TMP"' EXIT
  trap 'exit 130' INT TERM HUP # runs the EXIT trap

  cd "$HOME" # so a project's mise.toml in the current folder is not used or changed

  # mise: answer yes to every question.
  # all_compile=false: on Alpine, use ready-made musl builds instead of compiling (mise 2026 still compiles by default).
  export MISE_YES=1 MISE_ALL_COMPILE=false
}

# Run a command, write its output to the log, and keep the output of the last failure.
# The keyboard is not connected, so nothing can wait for an answer.
run() {
  printf '\n$ %s\n' "$*" >>"$LOG"
  # A big install is quiet for minutes. Say now and then that it still works, so nobody stops it.
  # It stops by itself when dejavu stops. Its sleep must not keep the output open.
  (
    s=0
    while sleep 30 >/dev/null 2>&1 && kill -0 $$ 2>/dev/null; do
      s=$((s + 30))
      say "Still working ($((s / 60)) min $((s % 60)) s). Big installs take a while. Don't stop it."
    done
  ) &
  beat=$!
  if "$@" </dev/null >"$TMP/out" 2>&1; then rc=0; else rc=$?; fi
  kill "$beat" 2>/dev/null || true
  wait "$beat" 2>/dev/null || true
  # Without progress bars and colors.
  grep -v -e '░' -e '████' "$TMP/out" | sed "s/$(printf '\033')\[[0-9;?]*[A-Za-z]//g" >"$TMP/step" || true
  cat "$TMP/step" >>"$LOG"
  [ "$rc" = 0 ] || cp "$TMP/step" "$TMP/fail"
  return "$rc"
}

ok() {
  OK=$((OK + 1))
  printf 'ok: %s\n' "$*"
}

needs_user() {
  NEEDS=$((NEEDS + 1))
  printf 'needs the user: %s\n' "$*"
}

# Print the error, the end of the failed command's output and a hint.
failed() {
  FAILED=$((FAILED + 1))
  printf 'failed: %s\n' "$*"
  if [ -s "$TMP/fail" ]; then
    tail -n 12 "$TMP/fail" | sed 's/^/    /'
    hint
    printf '    Full log: %s\n' "$LOG"
  fi
}

# Explain common errors in plain words.
hint() {
  f="$TMP/fail"
  if grep -qiE 'rate limit|API rate|403 Forbidden' "$f"; then
    echo "    hint: GitHub limits downloads without a token (60 per hour). Set GITHUB_TOKEN to any GitHub token (no scopes needed), or log in with: gh auth login"
  elif grep -qiE 'could not resolve|temporary failure in name resolution|network is unreachable|connection refused|timed out|dns error|error sending request|failed to connect|connection reset' "$f"; then
    echo "    hint: No internet, or a sandbox blocks it. Check the connection, or ask the user to let this command use the network."
  elif grep -qiE 'no space left' "$f"; then
    echo "    hint: The disk is full. Free some space (dejavu doctor shows how much is left)."
  elif grep -qiE 'dpkg was interrupted' "$f"; then
    echo "    hint: An earlier install was stopped. Ask the user to run: sudo dpkg --configure -a"
  elif grep -qiE 'could not get lock|unable to lock|database is locked|waiting for cache lock|another process|is locked' "$f"; then
    echo "    hint: Another install is running on this machine. Wait for it to finish, then try again."
  elif grep -qiE 'permission denied|operation not permitted|read-only file system' "$f"; then
    echo "    hint: No permission to write a file. If you run in a sandbox, ask the user to let this command run outside it."
  elif grep -qiE 'no matching skills|no skills found|no valid skills' "$f"; then
    echo "    hint: This skill was not found. Find the right name with: dejavu search skill:WORD"
  elif grep -qiE 'error while loading shared libraries' "$f"; then
    lib="$(sed -n 's/.*error while loading shared libraries: \([^:]*\):.*/\1/p' "$f" | head -n 1)"
    echo "    hint: The system library $lib is missing. Find its package with: dejavu search ${lib%%.so*}. Install it with: dejavu install system:NAME. Then try again."
  elif grep -qiE 'unable to locate package|no match for argument|target not found|not found in package names|no provider of|no available formula|unable to select packages|not found in registry|no packages found|404' "$f"; then
    echo "    hint: This name or version was not found. Find the right name with: dejavu search WORD"
    echo "    dejavu installs command-line tools. An app with windows (a browser, an editor like VS Code) is not one: the user installs it from the app store or the maker's website."
  fi
}

# Print the result, and exit with 0 (all ok), 1 (something failed) or 3 (the user must act).
finish() {
  # Several system packages need the password: one command, so the user types it once.
  # shellcheck disable=SC2086 # one word per package
  set -- $NEED_PKGS
  if [ $# -gt 1 ]; then
    pm_cmd install
    printf 'needs the user: to install them all at once, ask the user to run: sudo %s %s\n' "$CMD" "$*"
  fi
  if [ $((OK + FAILED + NEEDS)) -gt 1 ]; then
    printf 'summary: %s ok, %s failed, %s need the user\n' "$OK" "$FAILED" "$NEEDS"
  fi
  [ "$FAILED" = 0 ] || exit 1
  [ "$NEEDS" = 0 ] || exit 3
  exit 0
}

# Only names a package manager accepts: letters, digits and . _ + @ : / = ~ -
# No spaces, no options (a leading -, also after system: or npm:), nothing the shell could run.
# No files or URLs either: apt-get, dnf, zypper and apk install those as they are, as root,
# without their repositories (/tmp/x.deb, system:https://.../x.rpm, x.apk).
# Usage: check_name NAME [WHERE]
check_name() {
  case "$1" in
    "" | -* | *:-* | *[!A-Za-z0-9._+@:/=~-]*) fail "Not a package name${2:+ ($2)}: '$1'. Use one name per argument, like: dejavu install ripgrep" ;;
    [/.~]* | *:[/.~]* | *://* | *.deb | *.rpm | *.apk) fail "Not a package name${2:+ ($2)}: '$1'. dejavu installs packages by name, never a file or a URL. Find the name with: dejavu search WORD" ;;
  esac
}

# The name without its version: node@lts -> node, npm:@scope/pkg@1.2 -> npm:@scope/pkg.
base() {
  case "$1" in
    *:@*) b="${1#*:@}" && printf '%s:@%s\n' "${1%%:@*}" "${b%%@*}" ;;
    *) printf '%s\n' "${1%%@*}" ;;
  esac
}

# Download a URL to stdout, with curl or wget. Give up on a server that does not answer.
fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --retry 3 --connect-timeout 20 --max-time 600 "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- -T 20 "$1"
  else
    return 1
  fi
}

# --- The system package manager --------------------------------------------

find_pm() {
  PM=""
  if [ "$OS" = linux ]; then
    for p in apt-get dnf yum pacman zypper apk; do
      if command -v "$p" >/dev/null 2>&1; then PM=$p && return 0; fi
    done
  fi
  # Homebrew: on macOS, or on Linux without another package manager.
  # A script often starts without Homebrew in its PATH, so look in its usual places too.
  for b in "$(command -v brew 2>/dev/null || true)" /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
    if [ -n "$b" ] && [ -x "$b" ]; then
      PATH="$(dirname "$b"):$PATH"
      PM=brew
      return 0
    fi
  done
  return 1
}

# Set CMD to the command for ACTION: install, remove, upgrade, search, refresh, version, or
# can-remove (succeeds only when no other package needs the package).
pm_cmd() {
  case "$PM:$1" in
    apt-get:install) CMD="apt-get install -y -o DPkg::Lock::Timeout=300" ;;
    apt-get:remove) CMD="apt-get remove -y -o DPkg::Lock::Timeout=300" ;;
    apt-get:upgrade) CMD="apt-get install -y --only-upgrade -o DPkg::Lock::Timeout=300" ;;
    apt-get:search) CMD="apt-cache search --names-only" ;;
    apt-get:refresh) CMD="apt-get update -o DPkg::Lock::Timeout=300" ;;
    apt-get:can-remove) CMD="dpkg --dry-run --remove" ;;
    dnf:install | yum:install) CMD="$PM install -y" ;;
    dnf:remove | yum:remove) CMD="$PM remove -y" ;;
    dnf:upgrade | yum:upgrade) CMD="$PM upgrade -y" ;;
    dnf:search | yum:search) CMD="$PM search" ;;
    dnf:can-remove | yum:can-remove | zypper:can-remove) CMD="rpm --erase --test" ;;
    pacman:install | pacman:upgrade) CMD="pacman -S --needed --noconfirm" ;;
    pacman:remove) CMD="pacman -R --noconfirm" ;; # stops if another package needs it
    pacman:search) CMD="pacman -Ss" ;;
    pacman:refresh) CMD="pacman -Sy --noconfirm" ;;
    zypper:install) CMD="zypper --non-interactive install" ;;
    zypper:remove) CMD="zypper --non-interactive remove" ;;
    zypper:upgrade) CMD="zypper --non-interactive update" ;;
    zypper:search) CMD="zypper --non-interactive search" ;;
    apk:install) CMD="apk add" ;;
    apk:remove) CMD="apk del" ;; # keeps it if another package needs it
    apk:upgrade) CMD="apk upgrade" ;;
    apk:search) CMD="apk search" ;;
    apk:refresh) CMD="apk update" ;;
    brew:install) CMD="brew install --formula" ;;
    brew:remove) CMD="brew uninstall --formula" ;; # stops if another package needs it
    brew:upgrade) CMD="brew upgrade --formula" ;;
    brew:search) CMD="brew search --formula" ;;
    apt-get:version) CMD="dpkg-query -W -f=\${Version}" ;;
    dnf:version | yum:version | zypper:version) CMD="rpm -q --qf %{VERSION}-%{RELEASE}" ;;
    pacman:version) CMD="pacman -Q" ;;
    apk:version) CMD="apk list -I" ;;
    brew:version) CMD="brew list --versions --formula" ;;
    *) CMD="" ;;
  esac
}

# Run the system package manager with admin rights: as root, or with sudo or doas
# when they need no password. Returns 3 when only the user can give admin rights.
# Usage: pm ACTION NAME...
pm() {
  pm_cmd "$1"
  shift
  [ -n "$CMD" ] || return 0
  if [ "$PM" = brew ]; then # Homebrew never runs as root
    # shellcheck disable=SC2086 # CMD is several words
    run env HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_NO_INSTALL_CLEANUP=1 LC_ALL=C $CMD "$@"
    return
  fi
  if [ "$(id -u)" = 0 ]; then
    root=""
  elif command -v sudo >/dev/null 2>&1; then
    root="sudo -n"
  elif command -v doas >/dev/null 2>&1; then
    root="doas -n"
  else
    root="none"
  fi
  USER_CMD="sudo $CMD $*" # what the user can run in their terminal
  [ "$root" != none ] || return 3
  # shellcheck disable=SC2086 # root and CMD are several words
  if run $root env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a LC_ALL=C $CMD "$@"; then
    return 0
  elif grep -qiE 'password is required|a terminal is required|not in the sudoers|not allowed to|doas: (authentication|operation not permitted)' "$TMP/step"; then
    return 3
  else
    return 1
  fi
}

# Update the package list once per run, where an old or empty list breaks installs
# (fresh containers come with none). The others update it themselves.
refresh() {
  [ -z "${REFRESHED:-}" ] || return 0
  REFRESHED=1
  case "$PM" in
    apt-get) [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages*' -mmin -1440 2>/dev/null | head -n 1)" ] || return 0 ;;
    pacman) [ -z "$(ls /var/lib/pacman/sync 2>/dev/null)" ] || return 0 ;;
    apk) ;;
    *) return 0 ;;
  esac
  say "Updating the $PM package list..."
  pm refresh || true # if it fails, the install says why
}

# Usage: system ACTION NAME. Prints nothing; sets MSG. Returns 0 ok, 1 failed, 3 needs the user.
system() {
  if ! find_pm; then
    if [ "$OS" = macos ]; then
      MSG="$2 needs Homebrew, which is not installed. Ask the user to install it from https://brew.sh (it asks for their password), then run dejavu again."
      return 3
    fi
    MSG="no system package manager found (dejavu knows apt-get, dnf, yum, pacman, zypper, apk and Homebrew)."
    return 1
  fi
  case "$1" in
    install | upgrade) refresh ;;
    remove)
      # Never take other packages down with it.
      pm_cmd can-remove
      if [ -n "$CMD" ]; then
        if pm can-remove "$2"; then rc=0; else rc=$?; fi
        if [ "$rc" = 3 ]; then
          pm_cmd remove
          MSG="removing $2 needs admin rights. Ask the user to run this in their terminal (it asks for their password): sudo $CMD $2"
          return 3
        elif [ "$rc" != 0 ]; then
          MSG="other installed packages need $2, or it is not installed, so dejavu did not remove it. Ask the user before removing more."
          return 1
        fi
      fi
      ;;
  esac
  say "$1 $2 with $PM..."
  if pm "$1" "$2"; then
    MSG="$2 (with $PM)"
    [ "$1" = remove ] || return 0
    # apk del says ok, but keeps a package that other packages need.
    if [ "$PM" = apk ] && apk info -e "$2" >/dev/null 2>&1; then
      MSG="other installed packages need $2, so $PM kept it. Ask the user before removing more."
      return 1
    fi
    MSG="removed $MSG"
    return 0
  else
    rc=$?
  fi
  if [ "$rc" = 3 ]; then
    MSG="$2 needs admin rights. Ask the user to run this in their terminal (it asks for their password): $USER_CMD"
    [ "$1" != install ] || NEED_PKGS="$NEED_PKGS $2"
    return 3
  fi
  MSG="$2: $PM could not $1 it."
  return 1
}

# --- mise --------------------------------------------------------------------

# Find mise, or install it into ~/.local/bin (no admin rights needed).
ensure_mise() {
  MISE="$(command -v mise 2>/dev/null || true)"
  [ -n "$MISE" ] || [ ! -x "$BIN_DIR/mise" ] || MISE="$BIN_DIR/mise"
  [ -z "$MISE" ] || return 0

  say "Installing mise into $BIN_DIR (once)..."
  # The mise installer needs curl or wget, tar and awk. Slim containers miss some of them
  # (Debian slim: curl. openSUSE: awk). gawk has the same name everywhere.
  need=""
  command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1 || need="curl"
  command -v tar >/dev/null 2>&1 || need="$need tar"
  command -v awk >/dev/null 2>&1 || need="$need gawk"
  if [ -n "$need" ]; then
    find_pm || true
    [ "${PM:-}" != apt-get ] || need="$need ca-certificates"
    for n in $need; do
      system install "$n" || { MSG="dejavu needs $need to install mise. $MSG"; return 1; }
    done
  fi
  # mise.run checks the download with a checksum, and picks the right build (macOS, glibc or musl).
  if fetch https://mise.run >"$TMP/mise-install.sh" 2>"$TMP/step" &&
    run env MISE_INSTALL_PATH="$BIN_DIR/mise" sh "$TMP/mise-install.sh" &&
    [ -x "$BIN_DIR/mise" ]; then
    MISE="$BIN_DIR/mise"
    return 0
  fi
  [ -s "$TMP/fail" ] || cp "$TMP/step" "$TMP/fail"
  MSG="could not install mise."
  return 1
}

# Does the mise registry know this name? (ripgrep: yes. build-essential: no.)
in_registry() {
  ensure_mise && "$MISE" registry "$1" >/dev/null 2>&1
}

# Is this tool in the global mise config?
in_mise() {
  ensure_mise &&
    "$MISE" ls --global 2>/dev/null | cut -d ' ' -f 1 | grep -qxF -- "$1"
}

# The commands that mise can run, one per line.
shims() { LC_ALL=C ls "$SHIMS" 2>/dev/null || true; }

# Usage: mise_install SPEC. Sets MSG. Returns 0 ok, 1 failed.
mise_install() {
  ensure_mise || return 1
  # Some sources need a helper tool first. A plain name can come from one too:
  # prettier comes from npm. The registry says which source it uses.
  src="$1"
  case "$src" in *:*) ;; *) src="$("$MISE" registry "$(base "$1")" 2>/dev/null | cut -d ' ' -f 1)" ;; esac
  case "$src" in
    npm:*) dep=node ;; # its programs run with node
    pypi:* | pipx:*) dep=uv ;;
    cargo:*) dep=rust ;;
    go:*) dep=go ;;
    gem:*) dep=ruby ;;
    *) dep="" ;;
  esac
  bin="$dep"
  [ "$dep" != rust ] || bin=cargo
  if [ -n "$dep" ] && ! command -v "$bin" >/dev/null 2>&1 && ! "$MISE" which "$bin" >/dev/null 2>&1; then
    say "Installing $dep first, $1 needs it..."
    # Like any install: mise, else the system package manager (mise's node does not run on Alpine).
    # sh has no local variables, and mise_install changes dep: keep the message now.
    sys="$dep"
    [ "$dep" != node ] || [ "${PM:-}" = brew ] || sys=nodejs
    why="could not install $dep, which $1 needs."
    if mise_install "$dep"; then
      :
    elif find_pm && system install "$sys"; then
      :
    else
      rc=$?
      MSG="$why $MSG"
      return "$rc" # 3 when only the user can install it
    fi
  fi

  say "Installing $1 with mise..."
  shims >"$TMP/before"
  if ! run "$MISE" use --global "$1"; then
    MSG="mise could not install $1."
    return 1
  fi
  shims >"$TMP/after"
  LC_ALL=C comm -13 "$TMP/before" "$TMP/after" >"$TMP/new"

  # mise can download a build that does not run here, like a glibc build on Alpine.
  # Run the first new commands to be sure. 126/127: the system cannot start it.
  t="$(command -v timeout || command -v gtimeout || true)"
  if [ -n "$t" ]; then
    for c in $(head -n 3 "$TMP/new"); do
      p="$("$MISE" which "$c" 2>/dev/null)" || continue
      if "$t" 20 "$p" --version </dev/null >"$TMP/step" 2>&1; then continue; else rc=$?; fi
      if [ "$rc" = 126 ] || [ "$rc" = 127 ]; then
        printf '%s: cannot start (exit %s)\n' "$p" "$rc" >>"$TMP/step"
        cp "$TMP/step" "$TMP/fail"
        cat "$TMP/step" >>"$LOG"
        # Remove it completely, or its shim would hide a working copy from the system package manager.
        run "$MISE" unuse --global "$(base "$1")" || true
        run "$MISE" uninstall --all "$(base "$1")" || true
        run "$MISE" reshim || true
        MSG="mise installed $1, but its program does not run on this system."
        lib="$(sed -n 's/.*error while loading shared libraries: \([^:]*\):.*/\1/p' "$TMP/fail" | head -n 1)"
        [ -z "$lib" ] || MSG="mise installed $1, but its program needs the system library $lib, which is missing."
        return 1
      fi
    done
  fi

  cmds="$(head -n 20 "$TMP/new" | tr '\n' ' ' | sed 's/ $//')"
  more=$(($(wc -l <"$TMP/new") - 20))
  [ "$more" -le 0 ] || cmds="$cmds and $more more"
  if [ -z "$cmds" ]; then
    MSG="$1 (with mise. Its commands were already there)"
    return 0
  fi
  MSG="$1 (with mise). Commands: $cmds"
  # This shell, and an agent's shell started before setup, may not have the shims in PATH yet.
  # The example: the command named like the tool (python, not 2to3), else the first one.
  name="$(base "$1")"
  name="${name##*[:/]}"
  example="$(grep -x -- "$name" "$TMP/new" || head -n 1 "$TMP/new")"
  case ":$PATH:" in
    *":$SHIMS:"*) ;;
    *) MSG="$MSG
    This shell cannot find it by name yet. Run it with its full path, like: $SHIMS/$example" ;;
  esac
  return 0
}

# --- Agent skills --------------------------------------------------------------
# Instructions that teach AI agents a task. The skills CLI (https://skills.sh, npm:skills)
# installs them for the agents it finds. dejavu installs it with mise when needed.

# The folders of the AI agents on this machine, one per line.
agent_dirs() {
  for d in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "${CODEX_HOME:-$HOME/.codex}" "$HOME/.gemini" "$HOME/.config/agents" "$HOME/.agents"; do
    [ ! -d "$d" ] || printf '%s\n' "$d"
  done
}

# Run the skills CLI, without questions and without sending usage data.
skills_run() {
  ensure_mise || return 1
  # It downloads skills with git.
  if ! command -v git >/dev/null 2>&1; then
    say "Installing git first, agent skills need it..."
    system install git || { rc=$? && MSG="agent skills need git. $MSG" && return "$rc"; }
  fi
  if ! "$MISE" which skills >/dev/null 2>&1; then
    say "Installing the skills CLI first, for agent skills..."
    mise_install npm:skills || { MSG="could not install the skills CLI, which agent skills need. $MSG"; return 1; }
  fi
  # It needs Node.js 22.20 or newer. The system's node is often older (Debian 13: 20).
  v="$("$MISE" exec -- node -p process.versions.node 2>/dev/null || true)"
  if ! echo "$v" | awk -F. '{ exit !($1 > 22 || ($1 == 22 && $2 >= 20)) }'; then
    say "Agent skills need Node.js 22.20 or newer${v:+, this is $v}. Installing node@lts with mise..."
    mise_install node@lts || { MSG="agent skills need Node.js 22.20 or newer${v:+ (this machine has $v)}. $MSG"; return 1; }
  fi
  run env DISABLE_TELEMETRY=1 "$MISE" exec -- skills "$@" || { MSG="the skills CLI could not $1 it."; return 1; }
}

# The day a skill was installed or last updated, from the skills CLI's lock file. Empty if not installed.
skill_date() {
  lock="${XDG_STATE_HOME:+$XDG_STATE_HOME/skills/.skill-lock.json}"
  awk -v want="$1" '
    /^    "[^"]+": \{/ { k = $0; sub(/^    "/, "", k); sub(/".*/, "", k) }
    /^      "updatedAt": "/ && tolower(k) == tolower(want) { d = $0; sub(/^[^:]*: "/, "", d); print substr(d, 1, 10) }
  ' "${lock:-$HOME/.agents/.skill-lock.json}" 2>/dev/null | head -n 1
}

# Usage: skill ACTION skill:OWNER/REPO/NAME. Sets MSG. Returns 0 ok, 1 failed, 3 needs the user.
skill() {
  repo="${2#skill:}"
  name="${repo#*/*/}"
  [ "$name" != "$repo" ] || name=""
  repo="${repo%"/$name"}"
  case "/$repo/$name" in */-*) fail "Not a skill name: '$2'. Write it like this: skill:OWNER/REPO/NAME" ;; esac
  case "$repo" in */*) ;; *) fail "Not a skill name: '$2'. Write it like this: skill:OWNER/REPO/NAME" ;; esac
  if [ -z "$name" ]; then
    [ "$1" = install ] || { MSG="which skill from $repo? Write it like this: skill:$repo/NAME"; return 1; }
    # Show the skills in the repository: the agent picks one, with the user.
    skills_run add "$repo" --list || return
    cp "$TMP/step" "$TMP/fail"
    MSG="which skill from $repo? The list is below. Install one by its name: dejavu install skill:$repo/NAME"
    return 1
  fi
  if [ "$1" != install ] && [ -z "$(skill_date "$name")" ]; then
    MSG="the skill $name is not installed with dejavu."
    return 1
  fi
  case "$1" in
    install)
      if [ -z "$(agent_dirs)" ]; then
        MSG="no AI agent found in $HOME, so there is nothing to add the skill $name to. Install an AI agent first."
        return 1
      fi
      say "Installing the skill $name from $repo..."
      skills_run add "$repo" --skill "$name" --global --yes || return
      MSG="skill $name from $repo, for your AI agents. They see it in their next session."
      ;;
    remove)
      say "Removing the skill $name..."
      skills_run remove "$name" --global --yes || return
      MSG="removed the skill $name"
      ;;
    upgrade)
      say "Updating the skill $name..."
      skills_run update "$name" --global --yes || return
      MSG="the skill $name is up to date"
      ;;
  esac
}

# --- Your list ------------------------------------------------------------------
# One file with everything installed with dejavu, so `dejavu restore` can install
# it all again on another computer. One package per line, then a note: version, how.

# Set VER and VIA (mise or the package manager) for an installed package. Empty if not installed.
version_of() {
  VER=""
  VIA=""
  vkey="$(base "$1")"
  case "$vkey" in
    system:*) ;;
    skill:*)
      VER="$(skill_date "${vkey##*/}")"
      [ -z "$VER" ] || VIA=skills
      return 0
      ;;
    *)
      if in_mise "$vkey"; then
        VIA=mise
        VER="$("$MISE" ls --global 2>/dev/null | while read -r n v _; do [ "$n" != "$vkey" ] || echo "$v"; done | head -n 1)"
        return 0
      fi
      ;;
  esac
  find_pm || return 0
  n="${vkey#system:}"
  pm_cmd version
  # shellcheck disable=SC2086 # CMD is several words
  v="$($CMD "$n" 2>/dev/null)" || return 0
  # "jq 1.8.1", "busybox-1.37.0-r20 aarch64 ...", "5.2.37-2": keep the version.
  v="$(printf '%s\n' "$v" | head -n 1)"
  v="${v#"$n "}"
  v="${v#"$n-"}"
  VER="${v%% *}"
  [ -z "$VER" ] || VIA="$PM"
}

# Print the list without the line of package KEY. FOUND: the name on that line, if there was one.
list_without() {
  k="$1"
  FOUND=""
  [ -f "$LIST" ] || return 0
  while IFS= read -r l || [ -n "$l" ]; do
    # shellcheck disable=SC2086 # the words before the note
    set -- ${l%%#*}
    if [ $# -gt 0 ] && [ "$(base "$1")" = "$k" ]; then
      FOUND="$1"
      continue
    fi
    printf '%s\n' "$l"
  done <"$LIST"
}

# Replace the list with $TMP/list. A list that cannot be saved never stops an install.
save_list() {
  if mkdir -p "$(dirname "$LIST")" 2>/dev/null && cp "$TMP/list" "$LIST.new" 2>/dev/null; then
    mv -f "$LIST.new" "$LIST"
  else
    say "Could not save your list in $LIST."
  fi
}

# Write down an installed package, with its version.
record() {
  version_of "$1"
  note="$VER"
  [ -z "$VIA" ] || note="${note:+$note, }$VIA"
  {
    if [ -f "$LIST" ]; then
      list_without "$(base "$1")"
    else
      echo "# dejavu: the tools installed on this computer."
      echo "# To install them all on another computer, copy this file there and run: dejavu restore FILE"
      echo "# One package per line. To keep a version, write it like this: ripgrep@15.2.0. Text after # is a note."
      echo
    fi
    printf '%s%s\n' "$1" "${note:+  # $note}"
  } >"$TMP/list"
  save_list
}

forget() {
  [ -f "$LIST" ] || return 0
  list_without "$(base "$1")" >"$TMP/list"
  [ -z "$FOUND" ] || save_list
}

# Update the version in the list, for a package that is in it.
refresh_version() {
  list_without "$(base "$1")" >/dev/null
  [ -z "$FOUND" ] || record "$FOUND"
}

# The package names in a list file, one per line. Usage: list_names FILE WHERE
# Forgiving with hand-edited files: blank lines, notes, Windows line ends, several names on a line.
list_names() {
  bom="$(printf '\357\273\277')"
  tr -d '\r' <"$1" | sed "1s/^$bom//" >"$TMP/clean"
  where="$2"
  nr=0
  while IFS= read -r l || [ -n "$l" ]; do
    nr=$((nr + 1))
    # shellcheck disable=SC2086 # the words before the note
    for w in ${l%%#*}; do
      check_name "$w" "line $nr of $where"
      printf '%s\n' "$w"
    done
  done <"$TMP/clean"
}

show_list() {
  if ! grep -qv -e '^#' -e '^[[:space:]]*$' "$LIST" 2>/dev/null; then
    echo "Nothing is installed with dejavu yet. Your list will be in $LIST"
    return 0
  fi
  echo "Your list is in $LIST"
  echo "To install all of it on another computer: copy this file there, then run: dejavu restore FILE"
  echo
  grep -v -e '^#' -e '^[[:space:]]*$' "$LIST"
}

# Install everything in a list: a file, a URL, or your own list (to repair this computer).
restore() {
  src="$1"
  case "$src" in
    http://* | https://*) fetch "$src" >"$TMP/restore" 2>"$TMP/fail" || fail "Could not download the list from $src" ;;
    *)
      [ -f "$src" ] || fail "No list at $src. On the old computer, dejavu list shows where the list is."
      cp "$src" "$TMP/restore"
      ;;
  esac
  list_names "$TMP/restore" "$src" >"$TMP/names"
  count="$(wc -l <"$TMP/names" | tr -d ' ')"
  if [ "$count" = 0 ]; then
    MSG="the list $src has no packages"
    report 0
    return
  fi
  say "Installing the $count packages in $src. This can take a while. Don't stop it halfway."
  # A for loop, not `while read`: an install must not read the next names as its input.
  i=0
  # shellcheck disable=SC2013 # names have no spaces
  for n in $(cat "$TMP/names"); do
    i=$((i + 1))
    say "Package $i of $count: $n"
    install_and_record "$n"
  done
}

install_and_record() {
  install_one "$1"
  [ "$LAST" != 0 ] || record "$spec"
}

# --- Commands -----------------------------------------------------------------

report() { # Usage: report STATUS (from the last function). LAST keeps it.
  LAST="$1"
  case "$1" in
    0) ok "$MSG" ;;
    3) needs_user "$MSG" ;;
    *) failed "$MSG" ;;
  esac
}

# Agents write "FFmpeg" or "Ripgrep". Plain names are lowercase in every package manager.
# (Not github:Owner/Repo: there the case matters.)
# skills.sh writes skills as OWNER/REPO@NAME: dejavu reads that as skill:OWNER/REPO/NAME.
lower() {
  case "$1" in
    skill:*/*/*) printf '%s\n' "${1%%@*}" ;; # skills have no versions to pick
    skill:*@*) printf '%s\n' "$1" | sed 's|@|/|' ;;
    *:*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' ;;
  esac
}

install_one() {
  spec="$(lower "$1")"
  case "$spec" in
    system:*)
      if system install "${spec#system:}"; then report 0; else report $?; fi
      return
      ;;
    skill:*)
      if skill install "$spec"; then report 0; else report $?; fi
      return
      ;;
    *:*)
      if mise_install "$spec"; then report 0; else report $?; fi
      return
      ;;
    # Servers: mise has them too, but as a copy only this user can start, not a service
    # that starts with the computer. Use the system package manager first, mise if it has none.
    redis | postgres | mysql | mongodb | elasticsearch | clickhouse | minio | neo4j)
      if system install "$spec"; then report 0 && return; else rc=$?; fi
      [ "$rc" != 3 ] || { report 3; return; }
      say "$MSG Trying mise instead..."
      ;;
  esac
  if ! in_registry "$(base "$spec")"; then
    if system install "$spec"; then report 0; else report $?; fi
    return
  fi
  if mise_install "$spec"; then report 0 && return; else rc=$?; fi
  [ "$rc" != 3 ] || { report 3; return; } # a helper needs the user
  # A version was asked for: don't install another one from the system package manager.
  case "$spec" in *@*) report 1 && return ;; esac
  why="$MSG"
  cp "$TMP/fail" "$TMP/mise-fail"
  if find_pm; then
    say "$why Trying $PM instead..."
    if system install "$spec"; then
      report 0
      return
    else
      rc=$?
    fi
    MSG="$why So: $MSG"
    [ "$rc" = 3 ] && { report 3; return; }
  else
    MSG="$why"
    cp "$TMP/mise-fail" "$TMP/fail"
  fi
  report 1
}

remove_one() {
  spec="$(lower "$1")"
  case "$spec" in
    system:*)
      if system remove "${spec#system:}"; then report 0; else report $?; fi
      return
      ;;
    skill:*)
      if skill remove "$spec"; then report 0; else report $?; fi
      return
      ;;
  esac
  # Only what dejavu installed. A tool from the user, or from another setup (like brework), stays.
  list_without "$(base "$spec")" >/dev/null
  if [ -z "$FOUND" ]; then
    MSG="$spec is not on your list: dejavu did not install it, so it did not remove it. Ask the user first. To remove a system package anyway: dejavu remove system:$(base "$spec")"
    report 1
    return
  fi
  if in_mise "$(base "$spec")"; then
    say "Removing $spec with mise..."
    if run "$MISE" unuse --global "$(base "$spec")"; then
      MSG="removed $spec (with mise)"
      report 0
    else
      MSG="mise could not remove $spec."
      report 1
    fi
    return
  fi
  case "$spec" in
    *:*)
      MSG="$spec is not installed with mise."
      report 1
      return
      ;;
  esac
  if system remove "$spec"; then report 0; else report $?; fi
}

upgrade_one() {
  spec="$(lower "$1")"
  case "$spec" in
    system:*)
      if system upgrade "${spec#system:}"; then report 0; else report $?; fi
      return
      ;;
    skill:*)
      if skill upgrade "$spec"; then report 0; else report $?; fi
      return
      ;;
  esac
  if in_mise "$(base "$spec")"; then
    say "Upgrading $spec with mise..."
    if run "$MISE" upgrade "$(base "$spec")"; then
      MSG="$spec is up to date (with mise)"
      report 0
    else
      MSG="mise could not upgrade $spec."
      report 1
    fi
    return
  fi
  if system upgrade "$spec"; then report 0; else report $?; fi
}

upgrade_all() {
  if ensure_mise; then
    say "Upgrading the mise tools..."
    if run "$MISE" upgrade; then MSG="mise tools are up to date"; report 0; else MSG="mise could not upgrade every tool."; report 1; fi
    # mise from mise.run updates itself. From Homebrew or apt, that package manager updates it.
    if [ "$MISE" = "$BIN_DIR/mise" ]; then
      if run "$MISE" self-update --yes; then MSG="mise is up to date"; report 0; else MSG="mise could not update itself."; report 1; fi
    fi
    if "$MISE" which skills >/dev/null 2>&1; then
      say "Updating the agent skills..."
      if skills_run update --global --yes; then MSG="agent skills are up to date"; report 0; else report 1; fi
    fi
  else
    report 1
  fi
  if [ -f "$BIN_DIR/dejavu" ]; then
    if install_self download; then report 0; else report 1; fi
  fi
  if [ -f "$LIST" ]; then
    list_names "$LIST" "$LIST" >"$TMP/names" 2>/dev/null || true
    # shellcheck disable=SC2013 # names have no spaces
    for n in $(cat "$TMP/names"); do record "$n"; done
  fi
  say "System packages are not upgraded all at once, because it can restart services. Upgrade one with: dejavu upgrade system:NAME"
}

# Put dejavu in ~/.local/bin. Usage: install_self [download]
install_self() {
  if [ "${1:-}" != download ] && [ -n "$SELF" ] && grep -q '^# dejavu: one package manager' "$SELF" 2>/dev/null; then
    [ "$SELF" -ef "$BIN_DIR/dejavu" ] && { MSG="dejavu is in $BIN_DIR"; return 0; }
    cp "$SELF" "$TMP/dejavu"
  elif ! fetch "$DOWNLOAD_URL/dejavu" >"$TMP/dejavu" 2>"$TMP/fail"; then
    MSG="could not download dejavu from $DOWNLOAD_URL"
    return 1
  fi
  # Never install half a download.
  if ! grep -q '^# dejavu: one package manager' "$TMP/dejavu" || ! sh -n "$TMP/dejavu"; then
    MSG="the dejavu download is broken. Try again later."
    return 1
  fi
  mkdir -p "$BIN_DIR"
  chmod +x "$TMP/dejavu"
  mv -f "$TMP/dejavu" "$BIN_DIR/dejavu"
  MSG="dejavu $(sed -n 's/^VERSION=//p' "$BIN_DIR/dejavu") is in $BIN_DIR"
}

# Copy the agent skill to every AI agent on this machine, so they know how to use dejavu.
install_skill() {
  here="$(dirname "${SELF:-/nonexistent/x}")/skills/dejavu/SKILL.md"
  if [ -f "$here" ]; then
    cp "$here" "$TMP/SKILL.md"
  elif ! fetch "$DOWNLOAD_URL/SKILL.md" >"$TMP/SKILL.md" 2>"$TMP/fail" || ! grep -q '^name: dejavu' "$TMP/SKILL.md"; then
    MSG="could not download the agent skill from $DOWNLOAD_URL"
    return 1
  fi
  done_in=""
  for d in $(agent_dirs); do
    mkdir -p "$d/skills/dejavu" && cp "$TMP/SKILL.md" "$d/skills/dejavu/SKILL.md" && done_in="$done_in $d/skills"
  done
  if [ -n "$done_in" ]; then
    MSG="agent skill in:$done_in"
  else
    MSG="no AI agent found in $HOME, so no skill was added (run setup again after installing one)"
  fi
}

# Make every new shell find dejavu and the mise tools: login shells (scripts, SSH,
# AI agents) and terminals. A line that is already there is not added again.
setup_path() {
  line="export PATH=\"$BIN_DIR:$SHIMS:\$PATH\" $MARKER"
  files="$HOME/.profile" # sh, dash, and bash without a .bash_profile
  for f in .bashrc .bash_profile .bash_login .zprofile .zshrc; do
    [ ! -f "$HOME/$f" ] || files="$files $HOME/$f"
  done
  case "${SHELL:-}" in
    */zsh) files="$files $HOME/.zprofile $HOME/.zshrc" ;; # macOS
    */bash) files="$files $HOME/.bashrc" ;;
  esac
  changed=""
  for f in $files; do
    grep -qsF "$MARKER" "$f" && continue
    printf '\n%s\n' "$line" >>"$f" && changed="$changed $f"
  done
  if command -v fish >/dev/null 2>&1 || [ -d "$HOME/.config/fish" ]; then
    f="$HOME/.config/fish/conf.d/dejavu.fish"
    if [ ! -f "$f" ]; then
      mkdir -p "$(dirname "$f")"
      echo "fish_add_path --global \"$BIN_DIR\" \"$SHIMS\" $MARKER" >"$f" && changed="$changed $f"
    fi
  fi
  if [ -n "$changed" ]; then
    MSG="PATH set in:$changed. Open a new terminal to use it."
  else
    MSG="PATH was already set"
  fi
}

setup() {
  if ensure_mise; then MSG="mise is at $MISE"; report 0; else report 1; fi
  setup_path && report 0
  if install_self; then report 0; else report 1; fi
  if install_skill; then report 0; else report 1; fi
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *) say "To use dejavu in this shell now, run: export PATH=\"$BIN_DIR:$SHIMS:\$PATH\"" ;;
  esac
}

doctor() {
  if [ "$OS" = macos ]; then
    os="macOS $(sw_vers -productVersion 2>/dev/null)"
  else
    # shellcheck disable=SC1091 # a file of this machine
    os="$(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-Linux}" || echo Linux)"
    ! ldd --version 2>&1 | grep -qi musl || os="$os, musl"
  fi
  echo "dejavu: $VERSION (${SELF:-not a file})"
  echo "system: $os, $(uname -m)"
  if [ "$(id -u)" = 0 ]; then
    rights="yes (root)"
  elif command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    rights="yes (sudo without a password)"
  elif command -v sudo >/dev/null 2>&1; then
    rights="only with the user's password (sudo): system packages need the user"
  else
    rights="no (no sudo): only mise tools can be installed"
  fi
  echo "admin rights: $rights"
  if find_pm; then echo "system package manager: $PM"; else echo "system package manager: none"; fi
  m="$(command -v mise 2>/dev/null || { [ -x "$BIN_DIR/mise" ] && echo "$BIN_DIR/mise"; } || true)"
  if [ -n "$m" ]; then echo "mise: $("$m" --version 2>/dev/null | head -n 1) ($m)"; else echo "mise: not installed (dejavu installs it when needed)"; fi
  case ":$PATH:" in
    *":$SHIMS:"*) echo "PATH: ok" ;;
    *) echo "PATH: this shell does not have $SHIMS. Run dejavu setup, then open a new terminal" ;;
  esac
  if command -v curl >/dev/null 2>&1; then
    net="$(curl -fsS -m 10 -o /dev/null https://github.com 2>&1 && echo ok || echo "no: cannot reach github.com")"
  elif command -v wget >/dev/null 2>&1; then
    net="$(wget -q -T 10 -O /dev/null https://github.com 2>&1 && echo ok || echo "no: cannot reach github.com")"
  else
    net="unknown (no curl or wget)"
  fi
  echo "internet: $net"
  if [ -n "${GITHUB_TOKEN:-}${GH_TOKEN:-}${MISE_GITHUB_TOKEN:-}" ] || gh auth token >/dev/null 2>&1; then
    echo "GitHub token: yes"
  else
    echo "GitHub token: no (GitHub allows 60 downloads per hour without one)"
  fi
  echo "free disk space: $(df -Pk "$HOME" | tail -n 1 | { read -r _ _ _ kb _ && echo "$((kb / 1048576)) GB"; })"
  echo "logs: $STATE_DIR"
}

main() {
  cmd="${1:-help}"
  [ $# = 0 ] || shift
  case "$cmd" in
    install | add | remove | uninstall | upgrade | update) ;;
    restore)
      [ $# -le 1 ] || fail "Restore one list, for example: dejavu restore packages.txt"
      # A file name is relative to this folder: dejavu moves to the home folder later.
      src="${1:-$LIST}"
      case "$src" in /* | http://* | https://*) ;; *) src="$PWD/$src" ;; esac
      set --
      ;;
    *) [ $# = 0 ] || [ "$cmd" = search ] || fail "dejavu $cmd takes no names. See: dejavu help" ;;
  esac
  for n in "$@"; do check_name "$n"; done

  case "$cmd" in
    install | add)
      [ $# -gt 0 ] || fail "Which tool? For example: dejavu install ripgrep"
      start
      say "This can take a few minutes for big tools. Don't stop it halfway."
      for n in "$@"; do install_and_record "$n"; done
      ;;
    remove | uninstall)
      [ $# -gt 0 ] || fail "Which tool? For example: dejavu remove ripgrep"
      start
      for n in "$@"; do
        remove_one "$n"
        # Off the list when it is gone, or was never installed here (like after a restore that failed).
        list_without "$(base "$spec")" >/dev/null
        [ -n "$FOUND" ] || continue
        if [ "$LAST" = 0 ]; then
          forget "$spec"
        else
          version_of "$spec"
          [ -n "$VER" ] || forget "$spec"
        fi
      done
      ;;
    upgrade | update)
      start
      if [ $# = 0 ]; then
        upgrade_all
      else
        for n in "$@"; do
          upgrade_one "$n"
          [ "$LAST" != 0 ] || refresh_version "$spec"
        done
      fi
      ;;
    search)
      [ $# = 1 ] || fail "Search for one word, for example: dejavu search grep"
      start
      case "$1" in
        skill:*)
          skills_run find "${1#skill:}" || { report $? && finish; }
          echo "Agent skills on skills.sh (install with: dejavu install skill:OWNER/REPO@NAME):"
          grep -v -e 'npx skills' -e '^[[:space:]]*$' "$TMP/step" | head -n 30 | sed 's/^/  /'
          exit 0
          ;;
      esac
      if ensure_mise; then
        echo "From mise (install with: dejavu install NAME):"
        "$MISE" search "${1#*:}" 2>/dev/null | head -n 15 | sed 's/^/  /'
      fi
      if find_pm; then
        pm_cmd search
        echo "From $PM (install with: dejavu install system:NAME):"
        # Shortest names first: the exact name, then names that only contain it (pandoc before libghc-pandoc).
        # shellcheck disable=SC2086 # CMD is several words
        $CMD "${1#*:}" </dev/null 2>/dev/null | grep -v '^ ' |
          while IFS= read -r line; do n="${line%%[ :|]*}" && printf '%s\t%s\n' "${#n}" "$line"; done |
          sort -n -s | cut -f 2- | head -n 15 | sed 's/^/  /' || true
      fi
      exit 0
      ;;
    list | ls)
      show_list
      exit 0
      ;;
    restore)
      start
      restore "$src"
      ;;
    doctor)
      OS=linux
      [ "$(uname -s)" != Darwin ] || OS=macos
      doctor
      exit 0
      ;;
    setup)
      start
      setup
      ;;
    help | -h | --help) usage && exit 0 ;;
    version | -v | --version) echo "dejavu $VERSION" && exit 0 ;;
    *) usage >&2 && fail "Unknown command: $cmd. To install it, run: dejavu install $cmd" ;;
  esac
  finish
}

# All the work happens in main(), called on the last line.
# This way `curl | sh` only starts after the whole script has downloaded.
# shellcheck disable=SC2317 # main exits itself; this exit is the safety net
{ main "$@"; exit; }
